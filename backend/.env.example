# Database Config for FastAPI
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_sentinel

# Database Config for Docker-compose Postgres image
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_sentinel

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
